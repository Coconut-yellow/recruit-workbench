# 服务端口，默认 3000
PORT=3000

# 对外访问根地址（OAuth 回调与飞书工作台主页都基于它）
# 本地开发可省略，默认 http://localhost:3000
# 上线后改为公网 HTTPS，例如 https://recruit.example.com
PUBLIC_URL=http://localhost:3000

# 飞书企业自建应用（中国区 open.feishu.cn）
APP_ID=cli_aa61b8d7a3b89ce0
# 也可使用 FEISHU_APP_ID
# FEISHU_APP_ID=cli_aa61b8d7a3b89ce0

# 应用密钥：请放到环境变量，不要写入本文件后提交
# APP_SECRET=
# FEISHU_APP_SECRET=
# 若环境变量未设置，服务会尝试读取 /home/box/.config/lark-mcp/app_secret

# OAuth 回调地址，须与飞书开发者后台「安全设置 - 重定向 URL」完全一致
# 默认：{PUBLIC_URL}/auth/feishu/callback
# FEISHU_REDIRECT_URI=http://localhost:3000/auth/feishu/callback

# 会话签名。若省略，服务会在 data/session.secret 自动生成（已 gitignore）
# SESSION_SECRET=

# 本地开发登录（选择种子账号/角色）。设为 1 开启。
# 生产环境（NODE_ENV=production）不会默认开启，必须显式设置 DEV_LOGIN=1 才会出现入口
DEV_LOGIN=1

# 可选：候选人阶段变更时，额外通知到该飞书群（chat_id）
# FEISHU_NOTIFY_CHAT_ID=

NODE_ENV=development
